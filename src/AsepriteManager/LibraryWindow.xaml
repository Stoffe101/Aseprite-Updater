<UserControl x:Class="AsepriteManager.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#0C1220" Foreground="#F4F5FB" FontFamily="Segoe UI"
        FontSize="14" UseLayoutRounding="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Panel" Color="#172137"/>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0,0,10,9"/>
            <Setter Property="Foreground" Value="#F4F5FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#344461"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.36"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#101A2D"/>
            <Setter Property="Foreground" Value="#F2F5FF"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#F3F4FA"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Cell" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Cell" Property="Background" Value="#514879"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cell" Property="Background" Value="#354664"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0D1729"/>
            <Setter Property="Foreground" Value="#F1F4FC"/>
            <Setter Property="CaretBrush" Value="#D9B9FF"/>
            <Setter Property="BorderBrush" Value="#405271"/>
            <Setter Property="Padding" Value="11,9"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="#0C1220">
        <Grid.RowDefinitions><RowDefinition Height="5"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#8068DD"/>
        <ScrollViewer x:Name="LibraryScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="27,24,27,25">
                <TextBlock Text="ASEPRITE MANAGER  /  CREATOR'S LIBRARY"
                           Foreground="#B7A7F4" FontWeight="Bold" FontSize="12"/>
                <TextBlock Text="Creator’s Library" FontSize="23" FontWeight="Bold"
                           TextWrapping="Wrap" Margin="0,7,0,5"/>
                <TextBlock Text="Find and manage resources without leaving Aseprite Manager."
                           Foreground="#B5C1DA" TextWrapping="Wrap" Margin="0,0,0,20"/>

                <WrapPanel Margin="0,0,0,14">
                    <Button x:Name="TabTools" Content="Tools" Tag="tools" Click="Navigate_Click" MinWidth="96" Height="36" Margin="0,0,5,8"/>
                    <Button x:Name="TabPaletteImport" Content="Import" Tag="palette-import" Click="Navigate_Click" MinWidth="96" Height="36" Margin="0,0,5,8"/>
                    <Button x:Name="TabPalettes" Content="Palettes" Tag="palettes" Click="Navigate_Click" MinWidth="98" Height="36" Margin="0,0,5,8"/>
                    <Button x:Name="TabExtensions" Content="Extensions" Tag="extensions" Click="Navigate_Click" MinWidth="108" Height="36" Margin="0,0,5,8"/>
                    <Button x:Name="TabGodot" Content="Godot" Tag="godot" Click="Navigate_Click" MinWidth="96" Height="36" Margin="0,0,5,8"/>
                    <Button x:Name="TabBrushes" Content="Brushes" Tag="brushes" Click="Navigate_Click" MinWidth="96" Height="36" Margin="0,0,5,8"/>
                    <Button x:Name="TabBackups" Content="Backups" Tag="backup" Click="Navigate_Click" MinWidth="96" Height="36" Margin="0,0,5,8"/>
                </WrapPanel>

                <Border x:Name="StarterSection" Background="#21284A" BorderBrush="#62589E" BorderThickness="1"
                        CornerRadius="12" Padding="17" Margin="0,0,0,17">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="225"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="PIXELTOWN STARTER KIT" Foreground="#CBB8FF"
                                       FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="Install the four curated sprite-production scripts and your local prototype palette."
                                       TextWrapping="Wrap" Foreground="#D4DCF3" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Button x:Name="StarterKitButton" Grid.Column="1" Content="Set up PixelTown kit"
                                Background="#7357D4" Click="StarterKit_Click" Margin="0"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Grid x:Name="ToolSection" Margin="0,0,0,17">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Panel}" Padding="15"
                            BorderThickness="1" BorderBrush="#36445E" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="AUDITED ASEPRITE TOOLS" FontSize="12" FontWeight="Bold"
                                       Foreground="#B0BEE0" Margin="0,0,0,10"/>
                            <TextBlock Text="Search tools" Foreground="#889CB9" FontSize="12" Margin="0,0,0,4"/>
                            <CheckBox x:Name="ToolFavoritesOnly" Content="Favorites only" Margin="0,0,0,8" Foreground="#C6B5F5" Checked="FavoriteFilter_Changed" Unchecked="FavoriteFilter_Changed"/>
                            <TextBox x:Name="ToolSearch" Height="40" VerticalContentAlignment="Center"
                                     TextChanged="Search_Changed" ToolTip="Search by name, category or use case"/>
                            <ListBox x:Name="ToolList" Margin="0,10,0,0" Height="260"
                                     SelectionChanged="ToolList_SelectionChanged"
                                     DisplayMemberPath="Name"/>
                            <TextBlock Text="Official Aseprite examples • MIT licensed"
                                       Foreground="#8FA3C0" FontSize="11" TextWrapping="Wrap"
                                       Margin="0,11,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource Panel}" Padding="19"
                            BorderThickness="1" BorderBrush="#36445E" CornerRadius="12">
                        <StackPanel>
                            <TextBlock x:Name="ToolCategory" Text="TOOLS" Foreground="#AE9CFF"
                                       FontWeight="Bold" FontSize="12"/>
                            <TextBlock x:Name="ToolTitle" Text="Choose a tool" FontSize="22"
                                       FontWeight="Bold" Margin="0,9,0,6" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ToolDescription" Text="Select a resource from the left."
                                       TextWrapping="Wrap" Foreground="#D2D9E9"/>
                            <TextBlock x:Name="ToolPixelTown" TextWrapping="Wrap" Foreground="#AFC5DF"
                                       Margin="0,13,0,9"/>
                            <TextBlock x:Name="ToolStatus" Foreground="#B5A8F3" TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>
                            <WrapPanel>
                                <Button x:Name="InstallToolButton" Content="Install selected"
                                        Background="#7357D4" Click="InstallTool_Click"/>
                                <Button x:Name="RemoveToolButton" Content="Uninstall" Click="RemoveTool_Click"/>
                                <Button x:Name="FavoriteToolButton" Content="Add favorite" Click="FavoriteTool_Click"/>
                                <Button Content="View source" Click="OpenToolSource_Click"/>
                            </WrapPanel>
                            <TextBlock Text="Lua scripts can execute code. Only the explicitly reviewed, upstream examples are offered for direct installation. Confirm each install and review the source first."
                                       Foreground="#8498B4" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="PaletteSection" Background="{StaticResource Panel}" BorderThickness="1"
                        BorderBrush="#36445E" Padding="19" CornerRadius="12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="PALETTE WORKSHOP" FontWeight="Bold" Foreground="#AE9CFF" FontSize="12"/>
                        <TextBlock Text="Extract from PixelTown or import your own .gpl files"
                                   FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="0,8,0,6"/>
                        <TextBlock Text="Use your project's existing colors to start a consistent palette. This only reads local files and installs a new palette preset, without editing PixelTown or changing the palette of an open sprite."
                                   TextWrapping="Wrap" Foreground="#B6C5DB" Margin="0,0,0,14"/>
                        <WrapPanel>
                            <Button Content="Extract PixelTown palette" Click="ExtractPalette_Click"
                                    Background="#6557B1" MinWidth="220"/>
                            <Button Content="Extract full draft (206)" Click="ExtractFullPalette_Click"
                                    MinWidth="184"/>
                            <Button Content="Import local GPL palette" Click="ImportPalette_Click"
                                    MinWidth="204"/>
                            <Button Content="Open Aseprite palette folder" Click="OpenExtensions_Click"
                                    MinWidth="215"/>
                        </WrapPanel>
                        <TextBlock x:Name="PaletteStatus" Foreground="#B7C5E1" TextWrapping="Wrap"
                                   Text="PixelTown's current art is a prototype; extracted colors are not an approved final palette."/>
                    </StackPanel>
                </Border>

                <Border x:Name="GallerySection" Background="{StaticResource Panel}" BorderBrush="#36445E"
                        BorderThickness="1" CornerRadius="12" Padding="19" Margin="0,0,0,17">
                    <StackPanel>
                        <TextBlock Text="PALETTE DISCOVERY" Foreground="#C2B2FF" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="Explore color palettes without leaving Manager"
                                   FontSize="20" FontWeight="Bold" Margin="0,7,0,5" TextWrapping="Wrap"/>
                        <TextBlock Text="13 curated palettes available in Aseprite's upstream collection. Many are already bundled in Aseprite; these optional managed copies make discovering and comparing colors easier."
                                   TextWrapping="Wrap" Foreground="#B6C5DB" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Search palettes" Foreground="#889CB9" FontSize="12" Margin="0,0,0,4"/>
                                <CheckBox x:Name="PaletteFavoritesOnly" Content="Favorites only" Margin="0,0,0,8" Foreground="#C6B5F5" Checked="FavoriteFilter_Changed" Unchecked="FavoriteFilter_Changed"/>
                                <TextBox x:Name="PaletteSearch" Height="40" VerticalContentAlignment="Center"
                                         TextChanged="PaletteSearch_Changed" ToolTip="Search name, use case or creator"/>
                                <ListBox x:Name="GalleryList" Height="230" Margin="0,8,0,0"
                                         SelectionChanged="GalleryList_SelectionChanged" DisplayMemberPath="Name"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="GalleryTitle" Text="Select a palette"
                                           FontWeight="Bold" FontSize="19" TextWrapping="Wrap"/>
                                <TextBlock x:Name="GalleryDescription" Foreground="#BDC9DD"
                                           TextWrapping="Wrap" Margin="0,6,0,9"/>
                                <TextBlock x:Name="GalleryStatus" Foreground="#B7A8F0"
                                           TextWrapping="Wrap" Margin="0,0,0,9"/>
                                <WrapPanel x:Name="PaletteSwatches" MinHeight="50" Margin="0,0,0,9"/>
                                <WrapPanel>
                                    <Button x:Name="PreviewPaletteButton" Content="Preview colors"
                                            Click="PreviewPalette_Click"/>
                                    <Button x:Name="InstallPaletteButton" Content="Install preset"
                                            Click="InstallGalleryPalette_Click" Background="#6752B4"/>
                                    <Button x:Name="FavoritePaletteButton" Content="Add favorite" Click="FavoritePalette_Click"/>
                                    <Button x:Name="RemoveGalleryPaletteButton" Content="Uninstall copy"
                                            Click="RemoveGalleryPalette_Click"/>
                                    <Button x:Name="UpdateGalleryPalettesButton" Content="Update managed"
                                            Click="UpdateGalleryPalettes_Click"/>
                                    <Button Content="Source" Click="OpenPaletteSource_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="ExtensionSection" Background="{StaticResource Panel}" BorderBrush="#36445E"
                        BorderThickness="1" CornerRadius="12" Padding="19" Margin="0,0,0,17">
                    <StackPanel>
                        <TextBlock Text="COMMUNITY EXTENSION" Foreground="#C2B2FF"
                                   FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="Tile Index Overlay" FontSize="20" FontWeight="Bold"
                                   Margin="0,7,0,5"/>
                        <TextBlock Text="Add tile numbers on a temporary layer in Aseprite. Particularly useful for indexing PixelTown's square-grid sheets. MIT-licensed source by Pixeltica. This extension runs Lua and registers a keyboard shortcut."
                                   Foreground="#B7C6DD" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ExtensionStatus" Foreground="#B7A8F0" Margin="0,0,0,11"
                                   TextWrapping="Wrap" Text="Not checked"/>
                        <WrapPanel>
                            <Button x:Name="InstallOverlayButton" Content="Install / update overlay"
                                    Click="InstallOverlay_Click" Background="#6652AA" MinWidth="200"/>
                            <Button x:Name="RemoveOverlayButton" Content="Uninstall overlay"
                                    Click="RemoveOverlay_Click"/>
                            <Button Content="View extension source" Click="ViewOverlay_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="GodotSection" Background="{StaticResource Panel}" BorderBrush="#36445E"
                        BorderThickness="1" CornerRadius="12" Padding="19" Margin="0,0,0,17">
                    <StackPanel>
                        <TextBlock Text="GODOT 4  /  PIXELTOWN WORKFLOW"
                                   Foreground="#C2B2FF" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="Aseprite Wizard for Godot" FontSize="20"
                                   FontWeight="Bold" Margin="0,7,0,5"/>
                        <TextBlock Text="Import .aseprite animations, frames, layers and tilemap textures into Godot. Opt-in per project. Manager installs the MIT-licensed Godot 4 addon only; it never edits project.godot, enables the plugin, imports your sprites or modifies scenes."
                                   Foreground="#B7C6DD" TextWrapping="Wrap" Margin="0,0,0,13"/>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="152"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="GodotProjectPath" Grid.Column="0" Height="42"
                                     VerticalContentAlignment="Center" ToolTip="Local Godot project containing project.godot"
                                     TextChanged="GodotProjectPath_Changed"/>
                            <Button x:Name="BrowseGodotButton" Grid.Column="2"
                                    Content="Choose project" Click="BrowseGodot_Click"
                                    Margin="0" Height="42"/>
                        </Grid>
                        <TextBlock x:Name="GodotStatus" Text="Select your local PixelTown project folder."
                                   Foreground="#B7A8F0" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Button x:Name="InstallWizardButton" Content="Install / update Wizard"
                                    Click="InstallWizard_Click" Background="#6652AA" MinWidth="190"/>
                            <Button x:Name="RemoveWizardButton" Content="Uninstall Wizard"
                                    Click="RemoveWizard_Click"/>
                            <Button x:Name="CheckWizardButton" Content="Check Wizard update"
                                    Click="CheckWizard_Click"/>
                            <Button Content="Wizard source" Click="ViewWizard_Click"/>
                        </WrapPanel>
                        <TextBlock Text="Compatibility note: Godot 4 branch, with PixelTown's provisional Godot 4.7.2 not fully validated yet. After installing, enable it manually via Godot → Project → Project Settings → Plugins, then configure Aseprite's executable path."
                                   FontSize="12" Foreground="#8FA6C7" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border x:Name="BrushSection" Background="{StaticResource Panel}" BorderBrush="#36445E"
                        BorderThickness="1" CornerRadius="12" Padding="19" Margin="0,0,0,17">
                    <StackPanel>
                        <TextBlock Text="BRUSH SOURCE VAULT" Foreground="#C2B2FF"
                                   FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="Save brush stamps without risking Aseprite settings"
                                   FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="0,7,0,5"/>
                        <TextBlock Text="Import small PNG brush patterns into a reusable library. Open a stamp in Aseprite, select the pixels, then use Ctrl+B to create a custom brush. Manager intentionally does not patch Aseprite's user.aseprite-brushes file."
                                   Foreground="#B7C6DD" TextWrapping="Wrap" Margin="0,0,0,13"/>
                        <WrapPanel>
                            <Button Content="Import PNG brush stamp" Click="ImportBrush_Click"
                                    Background="#6652AA" MinWidth="202"/>
                            <Button Content="Open brush vault" Click="OpenBrushFolder_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="BrushStatus" Text="No changes to Aseprite's saved custom brushes."
                                   Foreground="#B7A8F0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border x:Name="BackupSection" Background="{StaticResource Panel}" BorderBrush="#36445E"
                        BorderThickness="1" CornerRadius="12" Padding="19" Margin="0,0,0,17">
                    <StackPanel>
                        <TextBlock Text="PROFILE BACKUP" Foreground="#C2B2FF" FontSize="12"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Save your complete Aseprite configuration"
                                   FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="0,7,0,5"/>
                        <TextBlock Text="Export a ZIP containing your settings, saved brushes, scripts, extensions and palettes. Aseprite must be closed. Your active profile is never edited. Restore is deliberately manual until a tested rollback workflow is available."
                                   Foreground="#B7C6DD" TextWrapping="Wrap" Margin="0,0,0,13"/>
                        <Button x:Name="BackupProfileButton" Content="Create profile backup ZIP"
                                HorizontalAlignment="Left" Background="#6652AA"
                                Click="BackupProfile_Click" MinWidth="226"/>
                        <TextBlock x:Name="BackupStatus" Text="No backup has been created this session."
                                   Foreground="#B7A8F0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border x:Name="ToolFooterSection" Background="#17243A" BorderThickness="1" BorderBrush="#354762"
                        Padding="16" CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="INSTALLATION ACTIVITY" Foreground="#AE9CFF"
                                   FontWeight="Bold" FontSize="12"/>
                        <TextBlock x:Name="LibraryStatus" Text="Ready" TextWrapping="Wrap"
                                   Foreground="#DCE5F6" Margin="0,9,0,12"/>
                        <WrapPanel>
                            <Button Content="Check tool updates" Click="CheckTools_Click"/>
                            <Button Content="Update managed tools" Click="UpdateTools_Click"
                                    Background="#6655A6"/>
                            <Button Content="Open scripts folder" Click="OpenScripts_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>