<UserControl x:Class="AsepriteManager.ControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#0C1220" Foreground="#EEF1FC" FontFamily="Segoe UI" FontSize="14">
  <UserControl.Resources>
    <SolidColorBrush x:Key="Panel" Color="#172137"/>
    <Style TargetType="Button">
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinWidth" Value="126"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="0,0,10,9"/>
      <Setter Property="Background" Value="#33435F"/>
      <Setter Property="Foreground" Value="#F7F8FC"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                    CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value="0.83"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#F1F5FD"/>
      <Setter Property="Background" Value="#101B30"/>
      <Setter Property="BorderBrush" Value="#435675"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,9"/>
      <Setter Property="CaretBrush" Value="#E3D6FF"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Foreground" Value="#EEF0F8"/>
      <Setter Property="Background" Value="#101B30"/>
      <Setter Property="BorderBrush" Value="#40516B"/>
    </Style>
    <Style x:Key="Header" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Description" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#B6C5DA"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </UserControl.Resources>
  <Grid Background="#0C1220">
    <Grid.RowDefinitions><RowDefinition Height="5"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#8B72E7"/>
    <Grid Grid.Row="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Margin="25,20,25,12">
        <TextBlock Text="ASEPRITE MANAGER / CONTROL CENTER" Foreground="#B7A5FA" FontSize="12" FontWeight="Bold"/>
        <TextBlock x:Name="PageHeading" Text="Keep your creative setup healthy." FontWeight="Bold" FontSize="26"
                   TextWrapping="Wrap" Margin="0,7,0,5"/>
        <TextBlock x:Name="PageSummary" Text="Review updates, protect your configuration, and track project toolkits."
                   Style="{StaticResource Description}"/>
      </StackPanel>
      <WrapPanel Grid.Row="1" Visibility="Collapsed" Margin="25,0,25,8">
        <Button x:Name="UpdatesTab" Content="Update Center" Tag="updates" Background="#6954B8"
                Click="Navigate_Click" MinWidth="152"/>
        <Button x:Name="RecoveryTab" Content="Recovery" Tag="recovery" Click="Navigate_Click"/>
        <Button x:Name="ProfilesTab" Content="Project Profiles" Tag="profiles" Click="Navigate_Click" MinWidth="153"/>
      </WrapPanel>
      <ScrollViewer Grid.Row="2" x:Name="PageScroller" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,8,25,28">
          <StackPanel x:Name="UpdatesPage">
            <Border Background="{StaticResource Panel}" BorderBrush="#344460" BorderThickness="1"
                    Padding="20" CornerRadius="12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Unified update review" Style="{StaticResource Header}"/>
                <TextBlock Text="One check for Aseprite, Manager releases, themes, Lua tools, managed palettes, Tile Index Overlay and the selected Godot project. Nothing gets installed automatically."
                           Style="{StaticResource Description}" Margin="0,7,0,14"/>
                <WrapPanel>
                  <Button x:Name="CheckAllButton" Content="Check all updates" Background="#765BD5"
                          Click="CheckAll_Click" MinWidth="200"/>
                  <Button Content="Review Aseprite versions" Click="ReviewAseprite_Click"
                          MinWidth="207"/>
                  <Button Content="Open Creator's Library" Click="OpenLibrary_Click"
                          MinWidth="196"/>
                </WrapPanel>
                <TextBlock x:Name="UpdateSummary" Text="Not checked yet."
                           Foreground="#C6B4FD" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Background="{StaticResource Panel}" BorderBrush="#344460" BorderThickness="1"
                    Padding="20" CornerRadius="12">
              <StackPanel>
                <TextBlock Text="Available sources" FontWeight="Bold" FontSize="17" Margin="0,0,0,12"/>
                <TextBlock Text="ASEPRITE" Foreground="#A994FA" FontWeight="Bold"/>
                <TextBlock x:Name="AsepriteUpdateStatus" Style="{StaticResource Description}" Text="Not checked." Margin="0,3,0,13"/>
                <TextBlock Text="MANAGER RELEASES" Foreground="#A994FA" FontWeight="Bold"/>
                <TextBlock x:Name="ManagerUpdateStatus" Style="{StaticResource Description}" Text="Not checked." Margin="0,3,0,8"/>
                <Button Content="View official Manager releases" HorizontalAlignment="Left"
                        Click="OpenManagerReleases_Click" MinWidth="230"/>
                <TextBlock Text="THEMES" Foreground="#A994FA" FontWeight="Bold"/>
                <TextBlock x:Name="ThemeUpdateStatus" Style="{StaticResource Description}" Text="Not checked." Margin="0,3,0,13"/>
                <TextBlock Text="LUA TOOLS" Foreground="#A994FA" FontWeight="Bold"/>
                <TextBlock x:Name="ToolUpdateStatus" Style="{StaticResource Description}" Text="Not checked." Margin="0,3,0,13"/>
                <TextBlock Text="PALETTES" Foreground="#A994FA" FontWeight="Bold"/>
                <TextBlock x:Name="PaletteUpdateStatus" Style="{StaticResource Description}" Text="Not checked." Margin="0,3,0,13"/>
                <TextBlock Text="TILE INDEX OVERLAY" Foreground="#A994FA" FontWeight="Bold"/>
                <TextBlock x:Name="OverlayUpdateStatus" Style="{StaticResource Description}" Text="Not checked." Margin="0,3,0,13"/>
                <TextBlock Text="GODOT ASEPRITE WIZARD" Foreground="#A994FA" FontWeight="Bold"/>
                <TextBlock x:Name="WizardUpdateStatus" Style="{StaticResource Description}" Text="Choose a project profile with a Godot folder to include Wizard checks." Margin="0,3,0,10"/>
                <TextBlock Text="For security, executable scripts and the source-built Aseprite app are updated through their dedicated review and confirmation dialogs. Manager self-updates require a separately published, verified installer."
                           Foreground="#8095B5" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="RecoveryPage" Visibility="Collapsed">
            <Border Background="{StaticResource Panel}" BorderBrush="#344460" BorderThickness="1"
                    Padding="20" CornerRadius="12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Backup and restore" Style="{StaticResource Header}"/>
                <TextBlock Text="Save or restore all Aseprite preferences, installed extensions, scripts, palettes and saved brushes. Your sprite projects in other folders are not included. Aseprite must be closed."
                           Style="{StaticResource Description}" Margin="0,7,0,14"/>
                <WrapPanel>
                  <Button x:Name="CreateBackupButton" Content="Create full backup ZIP"
                          Click="CreateBackup_Click" Background="#6652B0" MinWidth="206"/>
                  <Button x:Name="SelectRestoreButton" Content="Choose backup to inspect"
                          Click="ChooseRecovery_Click" MinWidth="210"/>
                </WrapPanel>
                <TextBlock x:Name="RecoveryDetails" Text="No backup selected. Restoring is always opt-in."
                           Style="{StaticResource Description}" Margin="0,5,0,12"/>
                <Button x:Name="RestoreButton" Content="Restore inspected backup"
                        Click="RestoreProfile_Click" IsEnabled="False"
                        HorizontalAlignment="Left" MinWidth="236" Background="#866247"/>
                <TextBlock Text="Recovery is transactional: validation and extraction happen first, then the active profile is swapped with a restored copy. The complete previous folder is retained alongside your Aseprite profile for rollback. Scripts in a restored profile may execute when later used."
                           Foreground="#9BACC8" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="ProfilesPage" Visibility="Collapsed">
            <Border Background="{StaticResource Panel}" BorderBrush="#344460" BorderThickness="1"
                    Padding="20" CornerRadius="12">
              <StackPanel>
                <TextBlock Text="Project toolkit profiles" Style="{StaticResource Header}"/>
                <TextBlock Text="Save a portable manifest of your installed tools, themes, palettes and optional Godot project. Profiles never replace Aseprite's global settings or modify a project on selection."
                           Style="{StaticResource Description}" Margin="0,7,0,13"/>
                <TextBlock Text="Profile name" Foreground="#B8C8DE" Margin="0,0,0,4"/>
                <TextBox x:Name="ProfileName" Text="PixelTown" Height="40" Margin="0,0,0,10"/>
                <TextBlock Text="Godot project folder (optional)" Foreground="#B8C8DE" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="ProjectFolderText" Grid.Column="0" Height="40" VerticalContentAlignment="Center"/>
                  <Button Grid.Column="2" Content="Browse" Click="BrowseProfileProject_Click" Margin="0"/>
                </Grid>
                <TextBlock Text="Notes" Foreground="#B8C8DE" Margin="0,0,0,4"/>
                <TextBox x:Name="ProfileNotes" Height="75" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>
                <WrapPanel>
                  <Button x:Name="SaveProfileButton" Content="Save installed toolkit"
                          Background="#6753B4" MinWidth="201" Click="SaveProfile_Click"/>
                  <Button Content="Import profile JSON" Click="ImportProfile_Click" MinWidth="186"/>
                </WrapPanel>
                <TextBlock Text="Saved profiles" FontWeight="Bold" Margin="0,10,0,6"/>
                <ListBox x:Name="SavedProfiles" Height="125" DisplayMemberPath="Name"
                         SelectionChanged="SavedProfiles_SelectionChanged"/>
                <TextBlock x:Name="ProfileDetails" Style="{StaticResource Description}"
                           Text="Select a saved profile to check its resources." Margin="0,10,0,10"/>
                <WrapPanel>
                  <Button Content="Check missing resources" Click="ReviewProfile_Click" MinWidth="204"/>
                  <Button Content="Export profile JSON" Click="ExportProfile_Click" MinWidth="182"/>
                  <Button Content="Open resource library" Click="OpenLibrary_Click" MinWidth="190"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
          <TextBlock x:Name="HubStatus" Text="Ready." Foreground="#B9A7FC"
                     TextWrapping="Wrap" Margin="0,14,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>