<Window x:Class="AsepriteManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aseprite Manager" Width="1040" Height="875" MinWidth="850" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="#0C1220" Foreground="#EEF1FC"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#172137"/>
        <SolidColorBrush x:Key="Secondary" Color="#ACB9CE"/>
        <Style TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#2D3D57"/>
            <Setter Property="Foreground" Value="#F7F8FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="41"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#162235"/>
            <Setter Property="Foreground" Value="#B9C8DD"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0E1729"/>
            <Setter Property="Foreground" Value="#F6F7FE"/>
            <Setter Property="CaretBrush" Value="#D6C3FF"/>
            <Setter Property="BorderBrush" Value="#364762"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,9"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F4F5FE"/>
            <Setter Property="Background" Value="#24324B"/>
            <Setter Property="BorderBrush" Value="#556987"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="MaxDropDownHeight" Value="350"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="SelectBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center" Margin="14,0,32,0"
                                                      IsHitTestVisible="False"/>
                                    <Path Data="M 0 0 L 5 5 L 10 0" Stroke="#B5C3D9"
                                          StrokeThickness="1.8" Width="11" Height="6"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Margin="0,0,15,0"/>
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade"
                                   Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="#202D43" BorderBrush="#526583"
                                        BorderThickness="1" CornerRadius="8" Margin="0,3,0,0">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SelectBorder" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="SelectBorder" Property="BorderBrush" Value="#A393FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F1F4FC"/>
            <Setter Property="Background" Value="#202D43"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#43557D"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#574C87"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AFC0DD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F4F6FC"/>
        </Style>
    </Window.Resources>
    <Grid Background="#0C1220">
        <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#7A5DEF" Offset="0"/>
                    <GradientStop Color="#58BBD3" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#111B2D" BorderBrush="#34425B" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="18,22,12,13">
                        <TextBlock Text="AM" Foreground="#C3B1FF" FontSize="25" FontWeight="Black"/>
                        <TextBlock Text="ASEPRITE MANAGER" Foreground="#B4C0D3" FontSize="10" FontWeight="Bold" Margin="0,5,0,2"/>
                        <TextBlock Text="v0.7  /  WINDOWS" Foreground="#8196B7" FontSize="10"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="11,0,10,4"><TextBlock Text="GENERAL" FontSize="11" FontWeight="Bold" Foreground="#849AB8" Margin="10,15,0,8"/><Button Style="{StaticResource SidebarButton}" x:Name="NavOverview" Content="Overview" Tag="overview" Click="Navigate_Click"/>
<Button Style="{StaticResource SidebarButton}" x:Name="NavAseprite" Content="Aseprite" Tag="aseprite" Click="Navigate_Click"/>
<Button Style="{StaticResource SidebarButton}" x:Name="NavThemes" Content="Themes" Tag="themes" Click="Navigate_Click"/>
<Button Style="{StaticResource SidebarButton}" x:Name="NavTools" Content="Creator&apos;s Library" Tag="tools" Click="Navigate_Click"/>
<Button Style="{StaticResource SidebarButton}" x:Name="NavUpdates" Content="Update Center" Tag="updates" Click="Navigate_Click"/>
<TextBlock Text="WORKSPACE" FontSize="11" FontWeight="Bold" Foreground="#849AB8" Margin="10,15,0,8"/><Button Style="{StaticResource SidebarButton}" x:Name="NavProfiles" Content="Project Profiles" Tag="profiles" Click="Navigate_Click"/>
<Button Style="{StaticResource SidebarButton}" x:Name="NavRecovery" Content="Recovery" Tag="recovery" Click="Navigate_Click"/>
<Button Style="{StaticResource SidebarButton}" x:Name="NavPerformance" Content="Build Performance" Tag="performance" Click="Navigate_Click"/>
<Button Style="{StaticResource SidebarButton}" x:Name="NavActivity" Content="Activity Log" Tag="activity" Click="Navigate_Click"/></StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" Margin="13,8,13,12" Padding="11" Background="#1D2A42" CornerRadius="10">
                        <StackPanel>
                            <TextBlock x:Name="ShellStage" Text="Ready" FontWeight="SemiBold" Foreground="#D4C8FF" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ShellDetail" Text="Select a section" FontSize="11" Foreground="#9DAFC8"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <ProgressBar x:Name="ShellProgress" Height="4" Maximum="100" Value="0" Margin="0,9,0,0"
                                         Foreground="#8A72E5" Background="#3C4A64"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        <ScrollViewer x:Name="MainScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="26,20,26,26">
                <StackPanel x:Name="OverviewPage">
                <Grid Margin="0,0,0,21">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" VerticalAlignment="Top" HorizontalAlignment="Left"
                            CornerRadius="12" Background="#273254" BorderThickness="1"
                            BorderBrush="#6E62B8">
                        <Grid>
                            <TextBlock x:Name="FallbackLogo" Text="A" FontWeight="Bold" FontSize="24"
                                       Foreground="#B5A1FF" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Image x:Name="OfficialLogo" Stretch="Uniform" Margin="6"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="ASEPRITE MANAGER   /   WINDOWS 11" Style="{StaticResource Label}"
                                   Foreground="#B6A7FD" Margin="0,0,0,5"/>
                        <TextBlock Text="Install, update and customize Aseprite."
                                   FontSize="27" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                        <TextBlock Text="Official source builds, curated themes and protected customizations."
                                   Foreground="{StaticResource Secondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <Border Background="#1C2945" CornerRadius="12" BorderBrush="#52628A" BorderThickness="1"
                        Padding="18" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="YOUR WORKSPACE" Foreground="#C2B2FF" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="Your pixel-art toolkit, without the setup headache." FontSize="18"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,12"/>
                        <WrapPanel>
                            <Button Content="Manage Aseprite" Click="OpenAsepritePage_Click" Background="#6952BB" Margin="0,0,9,8"/>
                            <Button Content="Creator's Library" Click="OpenLibrary_Click" Margin="0,0,9,8"/>
                            <Button Content="Check updates" Click="OpenControlCenter_Click" Margin="0,0,9,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Surface}" CornerRadius="13"
                            Padding="20" BorderThickness="1" BorderBrush="#324158">
                        <StackPanel>
                            <TextBlock Text="CURRENT INSTALLATION" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="InstalledVersion" Text="Checking..." FontSize="27"
                                       FontWeight="Bold" Margin="0,11,0,7" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="InstalledSubtitle" Foreground="{StaticResource Secondary}"
                                       TextWrapping="Wrap" MinHeight="22"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource Surface}" CornerRadius="13"
                            Padding="20" BorderThickness="1" BorderBrush="#324158">
                        <StackPanel>
                            <TextBlock Text="LATEST STABLE RELEASE" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="LatestVersion" Text="Not checked" FontSize="27"
                                       FontWeight="Bold" Margin="0,11,0,7" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="LatestSubtitle" Foreground="{StaticResource Secondary}"
                                       TextWrapping="Wrap" MinHeight="22"/>
                        </StackPanel>
                    </Border>
                </Grid>

                </StackPanel>
                <StackPanel x:Name="AsepritePage" Visibility="Collapsed">
                    <TextBlock Text="Aseprite installation" FontSize="24" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="Official releases, build tools and safe version switching."
                               Foreground="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                <Border Background="{StaticResource Surface}" CornerRadius="13"
                        Padding="20" BorderBrush="#324158" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Choose Aseprite version" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Select any published GitHub release, including older versions and previews."
                                   Foreground="{StaticResource Secondary}" TextWrapping="Wrap"
                                   Margin="0,6,0,13"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="172"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="VersionPicker" Grid.Column="0"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="VersionPicker_SelectionChanged"
                                      IsEnabled="False"
                                      ToolTip="Published versions from github.com/aseprite/aseprite/releases"/>
                            <Button Grid.Column="2" x:Name="CheckButton" Content="Check for updates"
                                    Click="Check_Click"/>
                        </Grid>
                        <TextBlock x:Name="VersionDetail" Foreground="#A4B4CF" Margin="0,11,0,0"
                                   TextWrapping="Wrap"
                                   Text="Click Check for updates to load available versions."/>
                        <WrapPanel Margin="0,14,0,0">
                            <Button x:Name="UpdateAsepriteButton" Content="Update Aseprite to latest"
                                    MinWidth="230" Margin="0,0,12,8" Background="#7357D4"
                                    Click="UpdateAseprite_Click" IsEnabled="False"/>
                            <TextBlock x:Name="AsepriteUpdateHint" Text="Check for updates to compare versions."
                                       Foreground="#AAB9CE" TextWrapping="Wrap" MaxWidth="420"
                                       VerticalAlignment="Center" Margin="0,0,0,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Surface}" CornerRadius="13"
                        Padding="20" BorderBrush="#324158" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Installation destination" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Use an empty folder for a fresh install, or the folder containing an existing source-built aseprite.exe."
                                   Foreground="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,6,0,13"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="124"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InstallPath" Grid.Column="0" Height="44"
                                     VerticalContentAlignment="Center" TextChanged="InstallPath_Changed"/>
                            <Button x:Name="BrowseButton" Grid.Column="2" Content="Browse folder"
                                    Click="Browse_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Surface}" CornerRadius="13"
                        Padding="20" BorderBrush="#324158" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Required build tools" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="DependencySummary" Foreground="{StaticResource Secondary}"
                                   TextWrapping="Wrap" Margin="0,8,0,13"
                                   Text="Scanning Git, Git Bash, CMake, Ninja, MSVC and the Windows SDK..."/>
                        <WrapPanel>
                            <Button x:Name="DepsButton" Content="Install missing tools" Click="Dependencies_Click"
                                    Background="#394066" MinWidth="184" Margin="0,0,12,0"/>
                            <TextBlock Text="Visual Studio C++ workload and Windows SDK may need administrator approval."
                                       MaxWidth="480" VerticalAlignment="Center" Foreground="#91A3C2"
                                       FontSize="12" TextWrapping="Wrap"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="#19243B" CornerRadius="13" BorderBrush="#505080"
                        BorderThickness="1" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="StatusTitle" Text="Ready" Style="{StaticResource SectionTitle}"
                                   Foreground="#CBB5FF"/>
                        <TextBlock x:Name="StatusDetail" Foreground="#BAC6DD" TextWrapping="Wrap"
                                   Margin="0,8,0,14"
                                   Text="Refresh releases to choose a version to install."/>
                        <ProgressBar x:Name="WorkProgress" Height="8" Maximum="100" Value="0"
                                     Foreground="#A18AF5" Background="#293752" BorderThickness="0"/>
                        <WrapPanel Margin="0,17,0,0">
                            <Button x:Name="InstallButton" Content="Install selected" Background="#785BE0"
                                    MinWidth="205" Margin="0,0,11,10" Click="Install_Click"/>
                            <Button x:Name="LaunchButton" Content="Launch Aseprite"
                                    MinWidth="164" Margin="0,0,11,10" Click="Launch_Click"/>
                            <Button Content="Open activity log" MinWidth="165"
                                    Margin="0,0,0,10" Click="OpenLog_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                </StackPanel>
                <StackPanel x:Name="ThemesPage" Visibility="Collapsed">
                    <TextBlock Text="Themes" FontSize="24" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="Manage your appearance without losing customizations."
                               Foreground="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                <Border Background="{StaticResource Surface}" CornerRadius="13"
                        Padding="20" BorderBrush="#324158" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Theme gallery" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="A hand-picked set of community themes. Install them to Aseprite's user profile without modifying the application or your sprites."
                                   Foreground="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="182"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ThemePicker" DisplayMemberPath="Name" Grid.Column="0"
                                      SelectionChanged="ThemePicker_SelectionChanged"/>
                            <Button x:Name="InstallThemeButton" Grid.Column="2" Content="Install selected theme"
                                    Click="InstallTheme_Click" Background="#514D82"/>
                        </Grid>
                        <TextBlock x:Name="ThemeDetail" Foreground="#A4B4CF" Margin="0,10,0,0"
                                   TextWrapping="Wrap" Text="Choose a theme to view its source and status."/>
                        <WrapPanel Margin="0,13,0,0">
                            <Button x:Name="InstallRecommendedButton" Content="Install recommended pack"
                                    Click="InstallRecommended_Click" Background="#6551A0"
                                    Margin="0,0,10,8" MinWidth="205"/>
                            <Button x:Name="CheckThemesButton" Content="Check theme updates"
                                    Click="CheckThemeUpdates_Click" Margin="0,0,10,8"/>
                            <Button x:Name="UpdateThemesButton" Content="Update installed themes"
                                    Click="UpdateThemes_Click" Background="#393F6A"
                                    Margin="0,0,10,8"/>
                            <Button x:Name="RemoveThemeButton" Content="Uninstall selected theme"
                                    Click="RemoveTheme_Click" Margin="0,0,10,8"/>
                            <Button Content="Open themes folder" Click="OpenThemesFolder_Click"
                                    Margin="0,0,0,8"/>
                        </WrapPanel>
                        <TextBlock Text="Recommended pack: Catppuccin Mocha, Dracula and Monaki. You can still install other themes individually." Foreground="#B1A6EC" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,5"/>
                        <TextBlock Text="If a theme was edited manually, automatic updating stops rather than replacing your changes. Apply your theme in Aseprite → Edit → Preferences → Theme."
                                   Foreground="#8199BA" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Surface}" CornerRadius="13" Padding="16"
                        BorderBrush="#324158" BorderThickness="1" Margin="0,0,0,16">
                    <WrapPanel>
                        <Button Content="Repair Aseprite shortcut / icon" Click="RepairIcon_Click"
                                Margin="0,0,12,7" MinWidth="235"/>
                        <TextBlock Text="Restore the official icon to the Windows Start Menu shortcut."
                                   Foreground="#A2B0C9" TextWrapping="Wrap" VerticalAlignment="Center"
                                   MaxWidth="455" Margin="0,0,0,7"/>
                    </WrapPanel>
                </Border>

                </StackPanel>
                <StackPanel x:Name="ActivityPage" Visibility="Collapsed">
                    <TextBlock Text="Activity and diagnostics" FontSize="24" FontWeight="Bold" Margin="0,0,0,16"/>
                <TextBlock Text="Activity" Style="{StaticResource SectionTitle}" Margin="0,0,0,9"/>
                <TextBox x:Name="ActivityLog" Height="420" IsReadOnly="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12" Text="Waiting for first action..."/>
                <TextBlock Text="Source builds take time and disk space. Older releases may not open projects saved in newer Aseprite versions."
                           Foreground="#879BB8" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>            <ContentControl x:Name="LibraryHost" Grid.Column="1" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            <ContentControl x:Name="ControlHost" Grid.Column="1" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            <ContentControl x:Name="PerformanceHost" Grid.Column="1" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>
