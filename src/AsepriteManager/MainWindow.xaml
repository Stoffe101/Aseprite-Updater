<Window x:Class="AsepriteManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aseprite Manager" Width="1060" Height="850" MinWidth="860" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="#0C101C" Foreground="#EBEFFA"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="Card" Color="#171E2E"/>
        <Style TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#2C344A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.83"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.36"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F6FE"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#101728"/>
            <Setter Property="Foreground" Value="#EFF2FA"/>
            <Setter Property="CaretBrush" Value="#E4C7FF"/>
            <Setter Property="BorderBrush" Value="#374159"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="7"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#7A5CF4" Offset="0"/>
                    <GradientStop Color="#49C5D4" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="38,30,38,36">
                <Grid Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="ASEPRITE / MANAGER" Foreground="#A991FF" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="Your pixel-art workshop, updated." FontSize="28" FontWeight="Bold" Margin="0,8,0,3"/>
                        <TextBlock Text="Install from source, manage build tools and update safely." Foreground="#A8B2CB"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#283048"
                            Padding="14,9" CornerRadius="14">
                        <TextBlock Text="WINDOWS 11   •   EARLY ACCESS" FontSize="11" FontWeight="SemiBold" Foreground="#CEC7FF"/>
                    </Border>
                </Grid>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Card}" CornerRadius="14" Padding="22" BorderBrush="#343D54" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="INSTALLED VERSION" Foreground="#AAB4CE" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="InstalledVersion" Text="Checking..." FontSize="30" FontWeight="Bold" Margin="0,10,0,6"/>
                            <TextBlock x:Name="InstalledSubtitle" Text="Searching selected installation path" Foreground="#A9B4CA" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource Card}" CornerRadius="14" Padding="22" BorderBrush="#343D54" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="LATEST STABLE ON GITHUB" Foreground="#AAB4CE" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LatestVersion" Text="Not checked" FontSize="30" FontWeight="Bold" Margin="0,10,0,6"/>
                            <TextBlock x:Name="LatestSubtitle" Text="Use Check for updates to query official releases" Foreground="#A9B4CA" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Background="{StaticResource Card}" CornerRadius="14" Padding="22" BorderBrush="#343D54" BorderThickness="1" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Installation" Style="{StaticResource Section}"/>
                        <TextBlock Text="Select the folder that contains aseprite.exe, or choose an empty folder for a new install."
                                   Foreground="#A8B2CB" Margin="0,6,0,13" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="InstallPath" Grid.Column="0" Height="44" VerticalContentAlignment="Center" TextChanged="InstallPath_Changed"/>
                            <Button x:Name="BrowseButton" Grid.Column="2" Content="Browse..." Click="Browse_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource Card}" CornerRadius="14" Padding="22" BorderBrush="#343D54" BorderThickness="1" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Build prerequisites" Style="{StaticResource Section}"/>
                            <TextBlock x:Name="DependencySummary" Text="Scanning Git, CMake, Ninja and Visual Studio C++..." Foreground="#A8B2CB" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="DepsButton" Grid.Column="1" Background="#373457" Content="Install missing tools" VerticalAlignment="Center" Click="Dependencies_Click"/>
                    </Grid>
                </Border>
                <Border Background="#141D33" BorderBrush="#41426E" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock x:Name="StatusTitle" Text="Ready" FontSize="18" FontWeight="SemiBold" Foreground="#D6C9FF"/>
                        <TextBlock x:Name="StatusDetail" Text="Check for updates to see the latest available release." Foreground="#B5BED2" Margin="0,7,0,12" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="WorkProgress" Height="7" Minimum="0" Maximum="100" Value="0" Foreground="#987AFF" Background="#28344F" BorderThickness="0"/>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="175"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="175"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="145"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CheckButton" Grid.Column="0" Content="Check for updates" Click="Check_Click"/>
                            <Button x:Name="InstallButton" Grid.Column="2" Content="Install Aseprite" Background="#7755DA" Click="Install_Click"/>
                            <Button x:Name="LaunchButton" Grid.Column="4" Content="Launch Aseprite" Click="Launch_Click"/>
                            <Button Grid.Column="6" Content="Open log" Click="OpenLog_Click" Background="#2B344A"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Activity" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Detailed output is also saved to disk." HorizontalAlignment="Right" Foreground="#8896B0" FontSize="12"/>
                </Grid>
                <TextBox x:Name="ActivityLog" Height="135" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Text="Waiting for first action..."/>
                <TextBlock Text="Unofficial project. Source builds may take a while and require several GB of disk space."
                           Foreground="#78859E" FontSize="12" Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
