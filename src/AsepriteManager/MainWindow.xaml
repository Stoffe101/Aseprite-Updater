<Window x:Class="AsepriteManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aseprite Manager" Width="1040" Height="875" MinWidth="850" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="#0C1220" Foreground="#EEF1FC"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#172137"/>
        <SolidColorBrush x:Key="Secondary" Color="#ACB9CE"/>
        <Style TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#2D3D57"/>
            <Setter Property="Foreground" Value="#F7F8FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0E1729"/>
            <Setter Property="Foreground" Value="#F6F7FE"/>
            <Setter Property="CaretBrush" Value="#D6C3FF"/>
            <Setter Property="BorderBrush" Value="#364762"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,9"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F8F8FF"/>
            <Setter Property="Background" Value="#25334D"/>
            <Setter Property="BorderBrush" Value="#617294"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="MaxDropDownHeight" Value="380"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EDF0FA"/>
            <Setter Property="Background" Value="#202D43"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AFC0DD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F4F6FC"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#7A5DEF" Offset="0"/>
                    <GradientStop Color="#58BBD3" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,28,32,32">
                <TextBlock Text="ASEPRITE MANAGER   /   WINDOWS 11" Style="{StaticResource Label}"
                           Foreground="#B6A7FD" Margin="0,0,0,8"/>
                <TextBlock Text="Build, install, and switch versions."
                           FontSize="29" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBlock Text="Official GitHub source releases. Your projects stay yours."
                           Foreground="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,21"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Surface}" CornerRadius="13"
                            Padding="20" BorderThickness="1" BorderBrush="#324158">
                        <StackPanel>
                            <TextBlock Text="CURRENT INSTALLATION" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="InstalledVersion" Text="Checking..." FontSize="27"
                                       FontWeight="Bold" Margin="0,11,0,7" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="InstalledSubtitle" Foreground="{StaticResource Secondary}"
                                       TextWrapping="Wrap" MinHeight="22"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource Surface}" CornerRadius="13"
                            Padding="20" BorderThickness="1" BorderBrush="#324158">
                        <StackPanel>
                            <TextBlock Text="LATEST STABLE RELEASE" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="LatestVersion" Text="Not checked" FontSize="27"
                                       FontWeight="Bold" Margin="0,11,0,7" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="LatestSubtitle" Foreground="{StaticResource Secondary}"
                                       TextWrapping="Wrap" MinHeight="22"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="{StaticResource Surface}" CornerRadius="13"
                        Padding="20" BorderBrush="#324158" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Choose Aseprite version" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Select any published GitHub release, including older versions and previews."
                                   Foreground="{StaticResource Secondary}" TextWrapping="Wrap"
                                   Margin="0,6,0,13"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="172"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="VersionPicker" Grid.Column="0"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="VersionPicker_SelectionChanged"
                                      IsEnabled="False"
                                      ToolTip="Published versions from github.com/aseprite/aseprite/releases"/>
                            <Button Grid.Column="2" x:Name="CheckButton" Content="Refresh releases"
                                    Click="Check_Click"/>
                        </Grid>
                        <TextBlock x:Name="VersionDetail" Foreground="#A4B4CF" Margin="0,11,0,0"
                                   TextWrapping="Wrap"
                                   Text="Click Refresh releases to load available versions."/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Surface}" CornerRadius="13"
                        Padding="20" BorderBrush="#324158" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Installation destination" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Use an empty folder for a fresh install, or the folder containing an existing source-built aseprite.exe."
                                   Foreground="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,6,0,13"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="124"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InstallPath" Grid.Column="0" Height="44"
                                     VerticalContentAlignment="Center" TextChanged="InstallPath_Changed"/>
                            <Button x:Name="BrowseButton" Grid.Column="2" Content="Browse folder"
                                    Click="Browse_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Surface}" CornerRadius="13"
                        Padding="20" BorderBrush="#324158" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Required build tools" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="DependencySummary" Foreground="{StaticResource Secondary}"
                                   TextWrapping="Wrap" Margin="0,8,0,13"
                                   Text="Scanning Git, Git Bash, CMake, Ninja, MSVC and the Windows SDK..."/>
                        <WrapPanel>
                            <Button x:Name="DepsButton" Content="Install missing tools" Click="Dependencies_Click"
                                    Background="#394066" MinWidth="184" Margin="0,0,12,0"/>
                            <TextBlock Text="Visual Studio C++ workload and Windows SDK may need administrator approval."
                                       MaxWidth="480" VerticalAlignment="Center" Foreground="#91A3C2"
                                       FontSize="12" TextWrapping="Wrap"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="#19243B" CornerRadius="13" BorderBrush="#505080"
                        BorderThickness="1" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="StatusTitle" Text="Ready" Style="{StaticResource SectionTitle}"
                                   Foreground="#CBB5FF"/>
                        <TextBlock x:Name="StatusDetail" Foreground="#BAC6DD" TextWrapping="Wrap"
                                   Margin="0,8,0,14"
                                   Text="Refresh releases to choose a version to install."/>
                        <ProgressBar x:Name="WorkProgress" Height="8" Maximum="100" Value="0"
                                     Foreground="#A18AF5" Background="#293752" BorderThickness="0"/>
                        <WrapPanel Margin="0,17,0,0">
                            <Button x:Name="InstallButton" Content="Install selected" Background="#785BE0"
                                    MinWidth="205" Margin="0,0,11,10" Click="Install_Click"/>
                            <Button x:Name="LaunchButton" Content="Launch Aseprite"
                                    MinWidth="164" Margin="0,0,11,10" Click="Launch_Click"/>
                            <Button Content="Open activity log" MinWidth="165"
                                    Margin="0,0,0,10" Click="OpenLog_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Activity" Style="{StaticResource SectionTitle}" Margin="0,0,0,9"/>
                <TextBox x:Name="ActivityLog" Height="124" IsReadOnly="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12" Text="Waiting for first action..."/>
                <TextBlock Text="Source builds take time and disk space. Older releases may not open projects saved in newer Aseprite versions."
                           Foreground="#879BB8" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
